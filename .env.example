# =====================================================
#  IPA Downloader Telegram Bot — Environment Config
# =====================================================
# Copy file này thành `.env` rồi điền giá trị thật.
# Copy this file to `.env` then fill in real values.

# --- Bot Configuration (REQUIRED) ---
# BOT_TOKEN: Lấy từ @BotFather trên Telegram
BOT_TOKEN=your_telegram_bot_token_here

# API_ID + API_HASH: Lấy từ https://my.telegram.org → API development tools
# (Cần để upload file > 50MB qua MTProto)
API_ID=your_telegram_api_id
API_HASH=your_telegram_api_hash

# ADMIN_ID: Telegram user ID của bạn (gửi /start vào @userinfobot để biết)
# Admin có quyền dùng /add /rm /listpre /listuser /check
ADMIN_ID=your_telegram_user_id

# --- Database (REQUIRED) ---
# MongoDB Atlas free tier: https://www.mongodb.com/cloud/atlas
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/?appName=botipa

# --- Encryption (REQUIRED — bảo vệ password user trong DB) ---
# Sinh key 32 bytes ngẫu nhiên. Cách tạo:
#   Linux/macOS:   openssl rand -base64 32
#   Windows PS:    [Convert]::ToBase64String((1..32 | %{Get-Random -Maximum 256}))
# QUAN TRỌNG: Không bao giờ commit key này lên Git! Đổi key = mất tất cả password đã lưu.
ENCRYPTION_KEY=

# --- Web Server (Optional) ---
# Cho /getlink — tạo link cài trực tiếp lên iPhone qua web
WEB_PORT=7098
HOST_URL=https://your-domain.com

# --- Limits (Optional, default values shown) ---
# Telegram Bot API free cho phép upload tới 2GB
DOWNLOAD_LIMIT_NORMAL=2048
DOWNLOAD_LIMIT_PREMIUM=4096

# Cooldown giữa các lần tải cho user thường (phút)
COOLDOWN_DURATION=15

# Session timeout cho các bước login (phút)
SESSION_TIMEOUT=5
